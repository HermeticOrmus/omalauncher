widget "trainer" {
  page: 2
  order: 2
  size: 6x5
  minSize: 3x3

  meta { owl: 8; description: "A card from Ormus Trainer's decks: tap to flip, next for the following one. The Trainer app keeps the real review schedule."; version: "1.2"; license: "MIT"; category: "learning" }

  state deck = "ai-terms" persist
  state pick = 0 persist
  state flipped = false
  // The last good copy, so the widget still has cards while Sun is off.
  state cards = [] persist

  // Published by the trainer-decks loop on Sun, reachable only on the tailnet. After a tap the widget refreshes its
  // sources, so picking another deck fetches it right away.
  source d = http("https://sun.tailb43a3a.ts.net/trainer-decks/${enc(deck)}.json") every 6h json timeout 20s status
  let fresh = d != null && d.ok && d.out.deck == deck ? d.out.cards : null
  // Shown straight from the fetch: `on` skips a source's first value, so the copy only covers Sun being off.
  let shown = fresh ?? cards
  when fresh != null { cards = fresh }
  on fresh { cards = value ?? cards }

  let card = len(shown) > 0 ? shown[pick % len(shown)] : null

  onTap: flipped = !flipped

  Column {
    gap: 8
    Row {
      gap: 6
      for id in ["ai-terms", "herdr", "polish"] {
        Button { text: id; color: id == deck ? accent : muted; onTap: { deck = id; pick = 0; flipped = false; cards = [] } }
      }
    }
    if card == null {
      Text { text: d == null ? "…" : "no cards yet: Sun's decks are on the tailnet"; style: muted; weight: 1 }
    } else {
      // The card takes the tile: a big prompt alone, then a smaller one above the whole answer once flipped.
      Column {
        weight: 1
        justify: center
        gap: 12
        Text { text: card.prompt; fontSize: flipped ? 20 : 26; bold: true; maxLines: 3 }
        if flipped {
          Text { text: card.answer; style: body; maxLines: 14 }
        } else {
          Text { text: "tap to flip"; style: muted }
        }
      }
    }
    Row {
      gap: 8
      align: center
      // A Text fills its row unless it has a width or weight; weight leaves the buttons their size.
      Text { text: len(shown) > 0 ? "${pick % len(shown) + 1} / ${len(shown)}" : ""; style: small; color: muted; weight: 1 }
      Button { text: "next"; onTap: { pick = pick + 1; flipped = false } }
      Button { text: "open trainer"; color: muted; onTap: androidApp("solutions.ormus.trainer") }
    }
  }
}
