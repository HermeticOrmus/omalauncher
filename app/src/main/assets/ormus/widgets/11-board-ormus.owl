widget "sessions-ormus" {
  page: 201
  order: 0
  size: 6x6
  minSize: 4x3

  meta { owl: 17; description: "Who needs Ormus first, one card at a time: every agent that waits on him, on every machine, as one line that says what the blockage is and where it is, with a key that opens the agent in Mercurio, where he answers it; swipe for the next. Under it, the agents at work; the tile's screen has every workboard, project and agent with the whole question and command. The chats are the comms tile's. `only` names one workboard (the board tiles are this file with three lines changed, see scripts/ormus-board-tiles.sh)."; version: "3.3"; license: "MIT"; category: "productivity" }

  // Built on sg (ormus-feeds), where Herdr, the keys and the chat registry live. The phone only reads the result
  // over the tailnet. A workboard is a Herdr session, a project is a Herdr workspace. `only` is "" for every
  // workboard, or one workboard's name: then the tile shows that board alone, with its own counts and moves.
  let only = "ormus"
  source f = http("https://sg.tailb43a3a.ts.net/feeds/sessions.json") every 60s json timeout 20s status
  source now = clock every 1m
  // Mercurio ships as solutions.ormus.logos, or .debug from a dev build: open whichever the phone has.
  source apps = android.apps every 10m
  let mercurio = (apps ?? []).find(a => a.package == "solutions.ormus.logos") ?? (apps ?? []).find(a => a.package == "solutions.ormus.logos.debug")
  // Mercurio opens a herdr-core terminal from a launcher's tap since 1.27.97 (versionCode 12797000); a build before
  // it sends the same intent down its old Herdr TUI path, so a tap opens Mercurio itself there.
  let watches = mercurio != null && (mercurio.versionCode ?? 0) >= 12797000

  // No alert of its own: Mercurio alerts (Ormus, 2026-11-26, "Adopt it"); this tile is the home-screen glance.
  // Quiet: Do Not Disturb with his own exceptions. It is his switch; this tile never turns it on by itself.
  source modes = android.modes

  let data = f != null && f.ok && f.out != null && f.out.boards != null ? f.out : null
  // How Mercurio names each machine (`ssh://user@host:port`) and the machine's tailnet names: a tap opens the agent there.
  let links = data != null ? (data.links ?? {}) : {}
  let hosts = data != null ? (data.hosts ?? {}) : {}
  let mercurioApp = mercurio != null ? mercurio.package : "solutions.ormus.logos"
  // Where a tap on an agent goes, built once for every agent the feed lists (`watch` on each, in `boards`): a herdr-core
  // agent opens in Mercurio, on its terminal's watch view (Ormus, 2026-11-26: one app opens the agents; Mercurio
  // 1.27.97, #350): the machine's link and tailnet names, the terminal's address, space and tab. With no link or names
  // for the machine, an older Mercurio, or no herdr-core agent `watch` is null: the tap opens Mercurio itself. A let
  // cannot be called and an action cannot run in an expression, so this is data and each tap runs the pair of actions.
  let boards = data != null ? data.boards.filter(b => only == "" || b.name == only).map(b => merge(b, {projects: b.projects.map(p => merge(p, {top: p.top.map(a => merge(a, {watch: a.session == "core" && watches && get(links, a.machine, null) != null && len(get(hosts, a.machine, [])) > 0 ? {package: mercurio.package, component: "org.connectbot.ui.MainActivity", action: "android.intent.action.VIEW", data: get(links, a.machine, ""), extras: {"solutions.ormus.logos.extra.CORE_ADDRESS": a.pane, "solutions.ormus.logos.extra.CORE_SPACE": p.name ?? "", "solutions.ormus.logos.extra.CORE_TAB": a.tab ?? "", "solutions.ormus.logos.extra.HERD_HOSTS": join(get(hosts, a.machine, []), ",")}} : null}))}))})) : []
  // sg is down or the phone is off the tailnet: say how old the list is instead of passing it off as live.
  let stale = data != null && now != null && now - data.generated > 180
  let down = data != null ? keys(data.machines ?? {}).filter(m => data.machines[m] != "ok") : []
  let failed = data != null ? keys(data.errors ?? {}) : []

  // Every agent, each with where it lives. The chats are the comms tile's: this tile is the builds.
  let agents = flatten(boards.map(b => flatten(b.projects.map(p => p.top.map(a => merge(a, {board: b.name, project: p.name}))))))
  let needs = data == null ? 0 : only == "" ? data.needs : sum(boards.map(b => b.agents.blocked))
  let working = data == null ? 0 : only == "" ? data.agents.working : sum(boards.map(b => b.agents.working))
  let done = data == null ? 0 : only == "" ? data.agents.done : sum(boards.map(b => b.agents.done))
  let game = data != null ? data.game : null
  // Boards with an agent in them; a board with none stays out of the way.
  let live = boards.filter(b => b.agents.blocked + b.agents.working + b.agents.done + b.agents.idle > 0)
  // The cards: every agent that needs him, one at a time: first the ones whose question has choices, then the ones
  // whose question the feed read with none, then the rest. `pick` is the card shown, by the agent's
  // place, so a card keeps its place when the list changes under it; a pick that is gone shows the first. `dragX`
  // is how far the finger has pulled the card sideways.
  let blocked = agents.filter(a => a.status == "blocked")
  let cards = flatten([blocked.filter(a => a.ask != null && len(a.ask.choices ?? a.ask.options ?? []) > 0), blocked.filter(a => a.ask != null && len(a.ask.choices ?? a.ask.options ?? []) == 0), blocked.filter(a => a.ask == null)])
  let ids = cards.map(a => "${a.machine}:${a.session}:${a.pane}")
  state pick = ""
  state dragX = 0
  let found = indexOf(ids, pick)
  // A card is `pinned` while it is the one picked; a pick that is gone shows the first. The first card is picked as the feed comes in.
  let pinned = found != null && found >= 0
  let at = pinned ? found : 0
  let card = len(cards) > 0 ? cards[at] : null
  on f {
    if pick == "" && len(ids) > 0 {
      pick = ids[0]
    }
  }
  // What moves besides: the agents at work. The finished ones are on the screen.
  let rows = agents.filter(a => a.status == "working")
  // The card's label: what the blockage is, in one line (the feed's `summary`, else the question); with no ask,
  // what the agent needs, or its title. Bold at 17 sp it holds about 10 dp a character, and wraps once at most.
  let cardLabel = card == null ? "" : card.ask != null ? (card.ask.summary ?? ((card.ask.question ?? "") != "" ? card.ask.question : "needs you")) : (card.needs ?? (card.title != "" && card.title != "Claude Code" ? card.title : card.tab != "" && !endsWith(card.tab, "Shell") ? card.tab : "needs you"))
  let cardLabelRows = len(cardLabel) > floor(((tileWidth ?? 360) - 64) / 10) ? 2 : 1
  // A yes on the tile shows the command it approves: its first line, when the summary carries the agent's own line
  // about it instead (the feed's rule: a yes is offered only with the command).
  let cardCommand = card != null && card.ask != null && card.ask.approval && (card.ask.about ?? "") != "" && (card.ask.what ?? "") != ""
  // Rows the tile holds under the headline, the score and the card. Measured on the emulator at 420 dpi, font scale 1
  // (2026-11-08): a card with one line of label and one row of keys is 126 dp (the open key is the same height as a
  // key then), a second line of label 22, a line of command 16; the title and the headline above the card 81, a row 24.
  let cardHeight = card == null ? 0 : 126 + 22 * (cardLabelRows - 1) + (cardCommand ? 16 : 0)
  let room = max(0, floor(((tileHeight ?? 400) - 100 - cardHeight) / 28))

  component Age(m) {
    Text { text: m == null ? "" : m < 60 ? "${m}m" : m < 1440 ? "${floor(m / 60)}h" : "${floor(m / 1440)}d"; fontSize: 12; color: muted; width: 30; align: end; maxLines: 1 }
  }

  // Mercurio's words: an agent that waits on him "needs you".
  component AgentLine(a, where) {
    Row {
      gap: 8
      align: center
      padding: [0, 4]
      Text { text: a.status == "blocked" ? "needs you" : a.status; fontSize: 12; width: 66; maxLines: 1; bold: a.status == "blocked"; color: a.status == "blocked" ? red : a.status == "working" ? blue : muted }
      // What it needs when the priorities tool knows; else its title, or its tab when the title says nothing.
      Text { text: a.needs ?? (a.title != "" && a.title != "Claude Code" ? a.title : a.tab != "" && !endsWith(a.tab, "Shell") ? a.tab : "${a.kind} in ${lower(a.project ?? "")}"); fontSize: 14; maxLines: 1; weight: 1; color: a.status == "idle" ? muted : foreground }
      Text { text: where; fontSize: 12; color: muted; width: 90; align: end; maxLines: 1 }
    }
  }

  // One row that opens the agent in Mercurio.
  component Item(i, where) {
    Box {
      onTap: {
        if i.watch != null {
          androidIntent(i.watch)
        } else {
          androidApp(mercurioApp)
        }
      }
      AgentLine { a: i; where: where }
    }
  }

  // A key: a wide button a thumb finds.
  component Key(word) {
    Box {
      fill: width
      padding: [14, 12]
      radius: 8 * corners
      background: alpha(foreground, 0.09)
      Text { text: word; fontSize: 15; bold: true; align: center; maxLines: 2; color: foreground }
    }
  }

  // Open an agent in Mercurio: its herdr-core terminal's watch view, or Mercurio itself.
  component OpenAgent(a, word) {
    Box {
      fill: width
      onTap: {
        if a.watch != null {
          androidIntent(a.watch)
        } else {
          androidApp(mercurioApp)
        }
      }
      Key { word: word }
    }
  }

  // The one agent that needs him now (`card`). `label` is one line that says what the blockage is (the feed's
  // `summary`: the dialog's heading and the agent's line about the command, a pick list's question, what the agent
  // needs at a free prompt), under it where it is, then one key that opens the agent in Mercurio, where he
  // answers it (Ormus, 2026-11-26: Mercurio owns answering); a tap anywhere else on the card does the same. The tile's
  // card (`compact`: little room) shows no command, but the first line of one whose summary is the agent's own line
  // about it; the screen also shows the question, what a yes would run and why, and the whole command.
  component NeedCard(a, label, compact) {
    Column {
      gap: 6
      padding: [12, 10]
      radius: 14 * corners
      background: alpha(foreground, 0.07)
      onTap: {
        if a.watch != null {
          androidIntent(a.watch)
        } else {
          androidApp(mercurioApp)
        }
      }
      let ask = a.ask
      let shown = ask != null ? (ask.run ?? ask.what ?? "") : ""
      Row {
        gap: 8
        align: center
        Text { text: "${lower(a.project)} · ${a.board}"; fontSize: 12; color: muted; weight: 1; maxLines: 1 }
        Text { text: len(cards) > 1 ? "${at + 1} of ${len(cards)}" : ""; fontSize: 12; color: muted; maxLines: 1 }
      }
      Text { text: label; fontSize: 17; bold: true; maxLines: 2 }
      Text { text: "${a.kind} on ${a.machine}${ask != null && (ask.prompt ?? false) ? " · at its prompt" : ""}"; fontSize: 12; color: muted; maxLines: 1 }
      if ask != null && !compact {
        if (ask.question ?? "") != "" && ask.question != label {
          Text { text: ask.question; fontSize: 14; maxLines: 2 }
        }
        if (ask.about ?? "") != "" && ask.about != label {
          Text { text: ask.about; fontSize: 13; maxLines: 2 }
        }
        if shown != "" {
          Text { text: shown; font: mono; fontSize: 12; maxLines: 4000 }
        }
        if ask.cut || (ask.more ?? false) {
          Text { text: ask.cut ? "the screen does not show all of it (${ask.lines} lines)" : "${ask.lines} lines: this is not all of it"; fontSize: 12; color: red; maxLines: 1 }
        }
        if (ask.why ?? "") != "" {
          Text { text: ask.why; fontSize: 13; color: muted; maxLines: 2 }
        }
      } else if ask != null && (ask.cut || (ask.more ?? false)) {
        Text { text: "the command is not whole here: open the agent"; fontSize: 12; color: red; maxLines: 1 }
      } else if cardCommand {
        Text { text: "${ask.what}${(ask.lines ?? 1) > 1 ? " …" : ""}"; font: mono; fontSize: 12; maxLines: 1 }
      }
      if ask != null && (ask.sent ?? false) {
        Row {
          gap: 8
          align: center
          Text { text: "answered from here"; fontSize: 13; color: foreground; weight: 1; maxLines: 1 }
          OpenAgent { a: a; word: "open" }
        }
      } else {
        OpenAgent { a: a; word: "open in Mercurio"; fill: width }
      }
    }
  }

  // The cards, one at a time: swipe sideways for the next or the one before, or tap the arrows. The card follows
  // the finger a little and springs back; a pull past 70 dp, or a flick, turns it.
  component Cards(compact) {
    Column {
      gap: 4
      Box {
        drag: horizontal
        onDrag: dragX = dragX + dx
        onDragEnd: {
          let n = len(cards)
          if n > 1 && (dragX < -70 || vx < -600) && at < n - 1 {
            pick = ids[at + 1]
            haptic()
          } else if n > 1 && (dragX > 70 || vx > 600) && at > 0 {
            pick = ids[at - 1]
            haptic()
          }
          dragX = 0
        }
        offset: [dragX * 0.6, 0]
        opacity: 1 - min(0.5, abs(dragX) / 400)
        animate offset: spring()
        animate opacity: tween(150ms, "out")
        NeedCard { a: card; label: cardLabel; compact: compact }
      }
      if len(cards) > 1 {
        // Up to seven dots (the card's header counts them all), the one shown bigger and brighter.
        Row {
          gap: 6
          align: center
          justify: center
          Text { text: "‹"; fontSize: 20; color: at > 0 ? foreground : alpha(foreground, 0.3); padding: [18, 10]; onTap: { dragX = 0; if at > 0 { pick = ids[at - 1] } } }
          for id, i in ids.take(7) key "${id}:${i}" {
            Box { size: i == at ? 8 : 6; radius: 4; background: i == at ? foreground : alpha(foreground, 0.3) }
          }
          Text { text: "›"; fontSize: 20; color: at < len(cards) - 1 ? foreground : alpha(foreground, 0.3); padding: [18, 10]; onTap: { dragX = 0; if at < len(cards) - 1 { pick = ids[at + 1] } } }
        }
      }
    }
  }

  // The headline: who needs him, in the needs-you red (gold when nobody does), with the score of the day beside it (the level and the
  // streak on the screen), and the other counts under it.
  component Headline(full) {
    Column {
      gap: 2
      Row {
        gap: 8
        align: center
        Text { text: needs > 0 ? "${needs} need you" : "nobody needs you"; font: serif; fontSize: 28; bold: false; color: needs > 0 ? red : accent; weight: 1; maxLines: 1 }
        if game != null {
          Progress { value: game.into; max: game.need; width: 48; height: 4; color: foreground; track: alpha(foreground, 0.2) }
          Text { text: "${game.today} today"; fontSize: 12; color: muted; maxLines: 1 }
        }
      }
      Text { text: "${working} working · ${done} done${full && game != null ? " · level ${game.level}${game.streak > 1 ? " · ${game.streak} days" : ""}" : ""}"; fontSize: 12; color: muted; maxLines: 1 }
    }
  }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: only == "" ? "sessions" : only; style: muted; weight: 1 }
      Text { text: f == null ? "…" : data == null ? "sg doesn't answer" : stale ? "as of ${floor((now - data.generated) / 60)}m ago" : len(down) > 0 ? "${join(down, ", ")} didn't answer" : len(failed) > 0 ? "${join(failed, ", ")} unreadable" : ""; fontSize: 12; color: data == null || len(down) > 0 || len(failed) > 0 ? red : muted; weight: 2; align: end; maxLines: 1 }
    }
    if data != null && only != "" && len(boards) == 0 {
      Text { text: "no ${only} board in the feed"; style: body; color: red }
    } else if data != null {
      Headline { full: false }
      if card != null {
        Cards { compact: true }
      }
      if only == "" && card == null {
        Row {
          gap: 12
          // Per workboard: the agents that need him, in the needs-you red; the screen has the agents by board.
          for b in live.filter(b => b.agents.blocked > 0).take(5) key b.name {
            Text { spans: [b.name, " ", {text: "${b.agents.blocked}", color: red, bold: true}]; fontSize: 12; color: muted; bold: false; maxLines: 1 }
          }
        }
      }
      for i in rows.take(room) key "${i.board}:${i.project}:${i.machine}:${i.session}:${i.pane}" {
        Item { i: i; where: "${lower(i.project)}" }
      }
      if len(rows) > room {
        Text { text: "+${len(rows) - room} more · ${only == "" ? "tap for every workboard" : "tap for all of ${only}"}"; fontSize: 12; color: muted; maxLines: 1 }
      }
    }
  }

  screen {
    title: only == "" ? "sessions" : only
    Column {
      scroll: true
      // Pulled down past its top: every source asks again now, not at its next interval.
      onPull: refresh()
      gap: 12
      padding: [4, 8]
      if data == null {
        Text { text: f == null ? "…" : "sg doesn't answer"; style: body; color: red }
      } else if only != "" && len(boards) == 0 {
        Text { text: "no ${only} board in the feed"; style: body; color: red }
      } else {
        Headline { full: true }
        if card != null {
          Cards { compact: false }
        }
        if stale || len(down) > 0 {
          Text { text: stale ? "as of ${floor((now - data.generated) / 60)}m ago" : "${join(down, ", ")} didn't answer: their agents are missing"; fontSize: 13; color: red }
        }
        let moves = (data.moves ?? []).filter(m => only == "" || m.board == only)
        if len(moves) > 0 {
          Column {
            gap: 2
            Text { text: "MOVED LATELY"; style: label }
            for m in reverse(moves).take(8) key "${m.n}" {
              Row {
                gap: 8
                align: center
                padding: [0, 3]
                Text { text: m.kind == "needs" ? "needs you" : m.kind == "done" ? "done" : m.kind == "chat" ? "chat" : "moved"; fontSize: 12; width: 66; maxLines: 1; color: m.kind == "needs" ? red : m.kind == "done" || m.kind == "chat" ? muted : foreground }
                Text { text: "${m.title} · ${m.text}"; fontSize: 13; weight: 1; maxLines: 1 }
                Age { m: now != null ? max(0, floor((now - m.at) / 60)) : null }
              }
            }
          }
        }
        Row {
          gap: 8
          align: center
          Text { text: modes == null ? "" : modes.dndAllows == "priority" ? "quiet is on: your exceptions only" : modes.dnd ? "quiet is on: ${modes.dndAllows == "alarms" ? "alarms only" : "total silence"}" : "quiet is off: every app can alert"; fontSize: 13; color: muted; weight: 1; maxLines: 2 }
          Button { text: modes != null && modes.dnd ? "turn off" : "quiet"; color: foreground; onTap: dnd(modes != null && modes.dnd ? "all" : "priority") }
        }
        for b in live key b.name {
          Column {
            gap: 4
            Row {
              align: center
              Text { text: upper(b.name); style: label; color: foreground; weight: 1 }
              Text { text: "${b.agents.blocked} need you · ${b.agents.working} working · ${b.agents.done} done · ${b.agents.idle} idle"; fontSize: 12; color: muted; align: end; maxLines: 1 }
            }
            for p in b.projects.filter(p => len(p.top) > 0) key p.name {
              Column {
                gap: 2
                padding: [0, 2]
                Text { text: p.name; fontSize: 13; bold: true; color: muted }
                for a in p.top key "${a.machine}:${a.session}:${a.pane}" {
                  Item { i: merge(a, {project: p.name}); where: "${a.kind} · ${a.machine}" }
                }
              }
            }
          }
        }
        for n in data.notes ?? [] {
          Text { text: n; fontSize: 13; color: muted }
        }
        for k in failed {
          Text { text: "${k}: ${data.errors[k]}"; fontSize: 13; color: red }
        }
      }
    }
  }
}
