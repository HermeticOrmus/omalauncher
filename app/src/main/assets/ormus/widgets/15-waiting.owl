widget "communications" {
  page: 1
  order: 0
  size: 6x3
  minSize: 3x2

  meta { owl: 8; description: "People waiting on Ormus: WhatsApp chats whose last word is theirs and email drafts waiting for Send. Newest first, the last 30 days; tap one to open it. Projects has the reviews and decisions."; version: "2.0"; license: "MIT"; category: "productivity" }

  // Built on Sun (ormus-feeds), where the keys live; the phone only reads the result over the tailnet.
  source f = http("https://sun.tailb43a3a.ts.net/feeds/waiting.json") every 2m json timeout 20s status
  source now = clock every 1m

  let data = f != null && f.ok ? f.out : null
  // Newest first: who waits now beats a review left open for months, which folds into a count.
  let all = data != null ? data.items.filter(i => i.source == "whatsapp" || i.source == "email").sortBy(i => i.age_min) : []
  let items = all.filter(i => i.age_min < 43200)
  let older = len(all) - len(items)
  let failed = data != null ? keys(data.errors ?? {}).filter(k => k == "whatsapp" || k == "email") : []
  // Sun off: say how old the list is instead of passing it off as live.
  let stale = data != null && now != null && now - data.generated > 600
  let room = max(2, floor(((tileHeight ?? 204) - 50) / 25))

  component Line(i) {
    Row {
      gap: 8
      align: center
      Text { text: i.source; style: small; width: 66; color: i.source == "whatsapp" ? green : blue }
      Text { text: i.title; style: body; maxLines: 1; weight: 1 }
      Text { text: i.who; style: small; color: muted; width: 70; align: end; maxLines: 1 }
      Text { text: i.age_min < 60 ? "${i.age_min}m" : i.age_min < 1440 ? "${floor(i.age_min / 60)}h" : "${floor(i.age_min / 1440)}d"; style: small; color: i.age_min > 1440 ? yellow : muted; width: 28; align: end }
    }
  }

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "communications · ${len(items)}"; style: muted; weight: 1 }
      Text { text: f == null ? "…" : !f.ok ? "Sun doesn't answer" : stale ? "as of ${floor((now - data.generated) / 60)}m ago" : len(failed) > 0 ? "${join(failed, ", ")} partly unreadable" : older > 0 ? "+${older} older than 30d" : ""; style: small; color: !f.ok || stale || len(failed) > 0 ? yellow : muted; weight: 1; align: end; maxLines: 1 }
    }
    if data != null && len(items) == 0 {
      Text { text: "nobody waits on you"; style: body; color: green }
    }
    for i in items.take(room) key "${i.source}:${i.title}" {
      // Handlers take one action, not a choice, so a row with no link is its own node.
      if i.url != null {
        Box { onTap: url(i.url); Line { i: i } }
      } else {
        Line { i: i }
      }
    }
  }
}
