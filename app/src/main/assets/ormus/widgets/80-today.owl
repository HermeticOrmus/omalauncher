widget "today" {
  page: 601
  order: 1
  size: 6x3
  minSize: 3x2

  meta { owl: 18; description: "Ormus's next meetings today and tomorrow from the phone's own calendars, with a countdown and a tap to open each, and the Alqvimia practice of the day."; version: "2.0"; license: "MIT"; category: "productivity" }

  // The meetings come from the phone's calendars (the accounts Android syncs), read on the phone: no network and no
  // sign-in on another machine; this tile sends no meeting anywhere. In this build only this file, exactly as the
  // launcher ships it, gets the calendars (Ormus.calendarOk), and the Linux guest's command gets none
  // (Ormus.GUEST_CALENDAR). Which calendars: the phone's own file, a JSON list of calendar names (an account's main
  // calendar carries its address as its name), so the addresses stay out of this file, which is public. Without that
  // file, or with an empty one, every calendar shows. All-day events are not meetings.
  source cal = android.calendar
  source shown = file("~/.config/omalauncher/today-calendars.json") json optional
  // The practice of the day: sg's copy of the today feed (ormus-feeds, built on Sun from the Alqvimia API).
  source f = http("https://sg.tailb43a3a.ts.net/feeds/today.json") every 15m json timeout 20s status
  source now = clock every 1m

  // A missing file reads as "" (docs/declarations.md); a file that is not a JSON list reads as its text, which
  // unique() makes a list of one: those, and an empty list, name no calendar, so every one shows.
  let listed = shown != null && shown != "" && unique(shown) != [shown] ? unique(shown) : []
  let names = len(listed) > 0 ? listed : null
  let practice = f != null && f.ok && f.out != null ? f.out.practice : null
  let granted = cal != null && cal.granted
  // Today and tomorrow, as the phone's clock counts days: from now to the midnight after tomorrow.
  let midnight = now == null ? null : parseTime(fmtTime(now, "yyyy-MM-dd"), "yyyy-MM-dd")
  let until = midnight == null ? null : midnight + 2 * 86400
  let events = granted ? cal.events.filter(e => !e.allDay && (until == null || e.start < until) && (names == null || contains(names, e.calendar))) : []
  let room = max(1, floor(((tileHeight ?? 204) - 74) / 25))
  // A copy of this file changed on the phone reads no calendar in this build (`gated`): a tap cannot change that.
  let gated = cal != null && cal.gated == true
  let head = cal == null ? "today …" : gated ? "today · only the shipped tile reads the calendar" : !granted ? "today · tap to read the calendar" : "today · ${len(events)} ahead"

  component Meeting(e) {
    Row {
      gap: 8
      align: center
      Text { text: fmtTime(e.start, "EEE HH:mm"); style: small; width: 76; color: muted }
      Text { text: e.title != "" ? e.title : "(no title)"; style: body; maxLines: 1; weight: 1 }
      Text { text: now == null ? "" : e.start <= now ? "now" : e.start - now < 3600 ? "in ${floor((e.start - now) / 60)}m" : e.start - now < 86400 ? "in ${floor((e.start - now) / 3600)}h" : ""; style: small; width: 52; align: end; color: now != null && e.start - now < 900 ? foreground : muted }
    }
  }

  Column {
    gap: 6
    if cal != null && !granted && !gated {
      // Only a tap asks Android; after two refusals it opens the launcher's page in Android's settings.
      Text { text: head; style: muted; color: foreground; maxLines: 1; onTap: calendar("request") }
    } else {
      // The calendar app on today.
      Text { text: head; style: muted; color: muted; maxLines: 1; onTap: calendar("open") }
    }
    if granted && len(events) == 0 {
      Text { text: "no meetings through tomorrow"; style: body; color: muted }
    }
    for e in events.take(room) key e.id {
      // A meeting whose place holds a Zoom, Teams, Meet or Webex link joins on a tap, to that link alone (an invitation
      // from anyone sets the place, so no other address opens); any other opens in the calendar app, which has the
      // join button. Handlers take one action, not a choice, so each is its own node.
      let join = match(e.location, "https://(?:[a-z0-9-]+\\.)*(?:zoom\\.us|teams\\.microsoft\\.com|teams\\.live\\.com|meet\\.google\\.com|webex\\.com)(?:[/?#][^\\s<>()\\[\\]]*)?(?=[\\s<>()\\[\\]]|$)")
      if join != null {
        Box { onTap: url(join); Meeting { e: e } }
      } else {
        Box { onTap: calendar("open", e); Meeting { e: e } }
      }
    }
    Spacer { weight: 1 }
    if practice != null {
      Text { text: "practice · ${practice.title}"; style: small; color: accent; maxLines: 1 }
    }
  }
}
