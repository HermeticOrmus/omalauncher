widget "people" {
  page: 102
  order: 0
  size: 6x5
  minSize: 3x2

  meta { owl: 8; description: "The people Ormus wants to stay close to, the most overdue first: how long since they last talked on WhatsApp, against how often he wants to, and what their company owes. Tap one to message them. The list lives on Sun in ~/.config/ormus-feeds/people.json."; version: "1.0"; license: "MIT"; category: "social" }

  source f = http("https://sun.tailb43a3a.ts.net/feeds/money.json") every 5m json timeout 20s status
  source now = clock every 1m

  let data = f != null && f.ok ? f.out : null
  let people = data != null ? data.people : []
  let due = people.filter(p => p.due >= 1)
  let stale = data != null && now != null && now - data.generated > 900
  let room = max(2, floor(((tileHeight ?? 340) - 50) / 25))

  component Line(p) {
    Row {
      gap: 8
      align: center
      Text { text: p.name; style: body; width: 112; maxLines: 1; color: p.due >= 1 ? yellow : foreground }
      Text { text: p.why; style: small; color: muted; weight: 1; maxLines: 1 }
      Text { text: p.owes_text != null ? "owes ${p.owes_text}" : ""; style: small; color: yellow; width: 84; align: end; maxLines: 1 }
      Text { text: p.last_min == null ? "never" : p.last_min < 60 ? "${p.last_min}m" : p.last_min < 1440 ? "${floor(p.last_min / 60)}h" : "${floor(p.last_min / 1440)}d"; style: small; width: 30; align: end; color: p.due >= 1 ? yellow : muted }
      Text { text: p.from_me ? "you" : "them"; style: small; color: p.from_me ? muted : green; width: 34; align: end }
    }
  }

  Column {
    gap: 6
    Row {
      align: center
      Text { text: len(due) > 0 ? "people · ${len(due)} to reach" : "people · all in touch"; style: muted; weight: 1 }
      Text { text: f == null ? "…" : !f.ok ? "Sun doesn't answer" : stale ? "as of ${floor((now - data.generated) / 60)}m ago" : data.errors.people != null ? "WhatsApp unreadable" : "last word"; style: small; color: !f.ok || stale || data.errors.people != null ? yellow : muted; weight: 1; align: end; maxLines: 1 }
    }
    for p in people.take(room) key p.name {
      if p.url != null {
        Box { onTap: url(p.url); Line { p: p } }
      } else {
        Line { p: p }
      }
    }
  }
}
