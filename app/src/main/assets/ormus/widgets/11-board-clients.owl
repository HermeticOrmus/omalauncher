widget "board-clients" {
  page: 401
  order: 0
  size: 6x6
  minSize: 4x3

  meta { owl: 13; description: "Who needs Ormus first, one card at a time: every agent that waits on him, on every machine, as one line that says what the blockage is and up to three numbered keys that move it forward (the dialog's answers, or his replies at a free prompt); a tap on the card opens the agent in Mercurio; swipe for the next. Under it, the chats that wait and the agents at work; the tile's screen has every workboard, project, agent and chat with the whole question and command. Tap a chat to open it in WhatsApp. `only` names one workboard (the board tiles are this file with three lines changed, see scripts/ormus-board-tiles.sh)."; version: "2.1"; license: "MIT"; category: "productivity" }

  // Built on sg (ormus-feeds), where Herdr, the keys and the chat registry live. The phone only reads the result
  // over the tailnet. A workboard is a Herdr session, a project is a Herdr workspace. `only` is "" for every
  // workboard, or one workboard's name: then the tile shows that board alone, with its own counts and moves.
  let only = "clients"
  source f = http("https://sg.tailb43a3a.ts.net/feeds/sessions.json") every 60s json timeout 20s status
  source now = clock every 1m
  // Mercurio ships as solutions.ormus.logos, or .debug from a dev build: open whichever the phone has.
  source apps = android.apps every 10m
  let mercurio = (apps ?? []).find(a => a.package == "solutions.ormus.logos") ?? (apps ?? []).find(a => a.package == "solutions.ormus.logos.debug")

  // One-tap answers. `busy` is the question being answered, `sent` what came back for it, and `said` the line shown
  // for it. sg's answer tool checks everything again before a key goes to the agent. What comes back is wrapped as
  // {"n": a number of its own, "r": the tool's answer}, so two equal answers in a row still count as two.
  state busy = ""
  state sent = ""
  state said = ""
  // The question `said` is about, so the line shows on that card, or under the headline when another card shows.
  state saidFor = ""
  on sent {
    let got = parseJson(value ?? "")
    let reply = got != null ? got.r : null
    saidFor = busy
    busy = ""
    dragX = 0
    if reply != null && reply.ok {
      haptic()
      said = "unlocked · ${reply.game.today} today"
    } else {
      said = reply == null ? "sg did not answer" : reply.outcome == "changed" ? "the question changed: look again" : reply.outcome == "not blocked" ? "already moving" : reply.outcome == "already answered" ? "already answered" : reply.outcome == "refused" ? "sg refused it" : reply.outcome == "not confirmed" ? "it may have arrived: open the agent" : "it did not go through: open the agent"
    }
    refresh()
  }

  // What moved, told while the phone sleeps. A widget's own sources run only while its page is on screen, so sg
  // sends each move here (owl-send sets `alert`) and the tile posts it as a notification. Nothing else alerts.
  // It starts as a move that is none: `on` does not run for a state's first value, and a null is not a value.
  state alert = {n: 0}
  on alert {
    if value != null && value.title != null {
      notify(value.title, value.text ?? "")
    }
  }
  // Quiet: Do Not Disturb with his own exceptions. It is his switch; this tile never turns it on by itself.
  source modes = android.modes

  let data = f != null && f.ok && f.out != null && f.out.boards != null ? f.out : null
  let boards = data != null ? data.boards.filter(b => only == "" || b.name == only) : []
  // Hosts as Mercurio's links name them (ssh://user@host:port#nickname), and each machine's names on the tailnet,
  // both from the feed: no address is in this file. Mercurio picks the saved host that attaches the agent's
  // session from the names, so a tap lands in the session whatever the phone calls the host.
  let links = data != null ? (data.links ?? {}) : {}
  let hosts = data != null ? (data.hosts ?? {}) : {}
  // sg is down or the phone is off the tailnet: say how old the list is instead of passing it off as live.
  let stale = data != null && now != null && now - data.generated > 180
  let down = data != null ? keys(data.machines ?? {}).filter(m => data.machines[m] != "ok") : []
  let failed = data != null ? keys(data.errors ?? {}) : []

  // Every agent and every project chat, each with where it lives.
  let agents = flatten(boards.map(b => flatten(b.projects.map(p => p.top.map(a => merge(a, {board: b.name, project: p.name, row: "agent"}))))))
  let chats = flatten(boards.map(b => flatten(b.projects.map(p => (p.chats ?? []).map(c => merge(c, {board: b.name, project: p.name, row: "chat"}))))))
  // A chat with no project belongs to no workboard: only the tile of every workboard shows them.
  let loose = data != null && only == "" ? (data.unsorted ?? []).map(c => merge(c, {board: "", project: "", row: "chat"})) : []
  let needs = data == null ? 0 : only == "" ? data.needs : sum(boards.map(b => b.agents.blocked))
  let working = data == null ? 0 : only == "" ? data.agents.working : sum(boards.map(b => b.agents.working))
  let done = data == null ? 0 : only == "" ? data.agents.done : sum(boards.map(b => b.agents.done))
  let waiting = data == null ? 0 : only == "" ? (data.waiting ?? 0) : sum(boards.map(b => b.waiting ?? 0))
  let game = data != null ? data.game : null
  // Boards with something in them; a board with no agent and no chat stays out of the way.
  let live = boards.filter(b => b.agents.blocked + b.agents.working + b.agents.done + b.agents.idle > 0 || (b.waiting ?? 0) > 0)

  // The cards: every agent that needs him, one at a time: first the ones one tap can answer, then the ones whose
  // question the feed read but cannot answer from here, then the rest. `pick` is the card shown, by the agent's
  // place, so a card keeps its place when the list changes under it; a pick that is gone shows the first. `dragX`
  // is how far the finger has pulled the card sideways.
  let blocked = agents.filter(a => a.status == "blocked")
  let cards = flatten([blocked.filter(a => a.ask != null && len(a.ask.choices ?? a.ask.options ?? []) > 0), blocked.filter(a => a.ask != null && len(a.ask.choices ?? a.ask.options ?? []) == 0), blocked.filter(a => a.ask == null)])
  let ids = cards.map(a => "${a.machine}:${a.session}:${a.pane}")
  state pick = ""
  state dragX = 0
  let found = indexOf(ids, pick)
  // A card is `pinned` while it is the one picked: only then are its keys live, so a refresh that puts another card
  // in its place cannot take a tap meant for the one he read. The first card is pinned as the feed comes in.
  let pinned = found != null && found >= 0
  let at = pinned ? found : 0
  let card = len(cards) > 0 ? cards[at] : null
  let shownQ = card == null ? "" : "${card.machine}:${card.session}:${card.pane}:${card.seq}:${card.ask != null ? card.ask.id : ""}"
  on f {
    if pick == "" && len(ids) > 0 {
      pick = ids[0]
    }
  }
  // What moves besides: the chats that wait on him, then the agents at work. The finished ones are on the screen.
  let rows = flatten([chats.filter(c => c.waiting), agents.filter(a => a.status == "working")])
  // Characters one line of a card holds at least, and the lines of a command the card on the screen may show
  // (the tile's card shows no command: the summary and the keys).
  let wide = floor(((tileWidth ?? 360) - 64) / 7.5)
  let cardLines = max(2, floor(((tileHeight ?? 400) - 315) / 16))
  // The tile's keys go side by side when each numbered label fits its share of the width, else in a stack.
  let cardKeys = card == null || card.ask == null ? [] : (card.ask.choices ?? [])
  let cardPer = max(6, floor(wide * 7.5 / max(1, len(cardKeys)) / 9) - 3)
  let cardStack = len(cardKeys) > 0 && !(len(cardKeys) <= 3 && all(cardKeys, o => len(o.label) + 2 <= cardPer))
  // Rows the tile holds under the headline, the score and the card.
  let cardHeight = card == null ? 0 : cardStack ? 200 + 38 * len(cardKeys) : 215
  let room = max(0, floor(((tileHeight ?? 400) - 100 - cardHeight) / 28))

  component Age(m) {
    Text { text: m == null ? "" : m < 60 ? "${m}m" : m < 1440 ? "${floor(m / 60)}h" : "${floor(m / 1440)}d"; fontSize: 12; color: muted; width: 30; align: end; maxLines: 1 }
  }

  // Mercurio's words: an agent that waits on him "needs you".
  component AgentLine(a, where) {
    Row {
      gap: 8
      align: center
      padding: [0, 4]
      Text { text: a.status == "blocked" ? "needs you" : a.status; fontSize: 12; width: 66; maxLines: 1; bold: a.status == "blocked"; color: a.status == "blocked" ? accent : a.status == "working" ? foreground : a.status == "done" ? green : muted }
      // What it needs when the priorities tool knows; else its title, or its tab when the title says nothing.
      Text { text: a.needs ?? (a.title != "" && a.title != "Claude Code" ? a.title : a.tab != "" && !endsWith(a.tab, "Shell") ? a.tab : "${a.kind} in ${lower(a.project ?? "")}"); fontSize: 14; maxLines: 1; weight: 1; color: a.status == "idle" ? muted : foreground }
      Text { text: where; fontSize: 12; color: muted; width: 90; align: end; maxLines: 1 }
    }
  }

  component ChatLine(c, where, withText) {
    Row {
      gap: 8
      align: center
      padding: [0, 4]
      Text { text: c.waiting ? "chat" : c.mine ? "you" : "quiet"; fontSize: 12; width: 66; maxLines: 1; color: c.waiting ? green : muted }
      Text { text: withText && c.text != "" ? "${c.name}: ${c.text}" : c.name; fontSize: 14; maxLines: 1; weight: 1; color: c.waiting ? foreground : muted }
      Text { text: where; fontSize: 12; color: muted; width: 90; align: end; maxLines: 1 }
      Age { m: c.age_min }
    }
  }

  // One row that opens what it shows: an agent's chat in Mercurio, or a WhatsApp chat.
  component Item(i, where, withText) {
    Box {
      onTap: {
        if i.row == "agent" {
          if mercurio != null && get(links, i.machine, null) != null {
            androidIntent({package: mercurio.package, component: "org.connectbot.ui.MainActivity", action: "android.intent.action.VIEW", data: get(links, i.machine, ""), extras: {"solutions.ormus.logos.extra.HERD_PANE": i.pane, "solutions.ormus.logos.extra.HERD_SESSION": i.session, "solutions.ormus.logos.extra.HERD_VIEW": "chat", "solutions.ormus.logos.extra.HERD_HOSTS": join(get(hosts, i.machine, []), ",")}})
          } else {
            androidApp(mercurio != null ? mercurio.package : "solutions.ormus.logos")
          }
        } else if i.open.url != null {
          androidIntent({package: "com.whatsapp", action: "android.intent.action.VIEW", data: i.open.url})
        } else {
          androidIntent({package: "com.whatsapp", component: "com.whatsapp.Conversation", extras: {jid: i.open.jid}})
        }
      }
      if i.row == "agent" {
        AgentLine { a: i; where: where }
      } else {
        ChatLine { c: i; where: where; withText: withText }
      }
    }
  }

  // A key: a wide button a thumb finds. `strong` is the one answer the card leads with.
  component Key(word, strong = false) {
    Box {
      fill: width
      padding: [14, 12]
      radius: 8 * corners
      background: alpha(foreground, strong ? 0.16 : 0.09)
      Text { text: word; fontSize: 15; bold: true; align: center; maxLines: 2 }
    }
  }

  // Open an agent's chat in Mercurio, or Mercurio itself when the feed has no link for its machine.
  component OpenAgent(a, word) {
    Box {
      fill: width
      onTap: {
        if mercurio != null && get(links, a.machine, null) != null {
          androidIntent({package: mercurio.package, component: "org.connectbot.ui.MainActivity", action: "android.intent.action.VIEW", data: get(links, a.machine, ""), extras: {"solutions.ormus.logos.extra.HERD_PANE": a.pane, "solutions.ormus.logos.extra.HERD_SESSION": a.session, "solutions.ormus.logos.extra.HERD_VIEW": "chat", "solutions.ormus.logos.extra.HERD_HOSTS": join(get(hosts, a.machine, []), ",")}})
        } else {
          androidApp(mercurio != null ? mercurio.package : "solutions.ormus.logos")
        }
      }
      Key { word: word }
    }
  }

  // One choice, numbered: a dialog's answer sends its key, a reply at a free prompt sends its number and the label
  // this key showed (the text is sg's, from his registry, and sg sends it only when it is still that label; the
  // phone never sends text of its own). It goes to sg's answer tool as JSON on stdin, so no shell on the way reads
  // it as code. `term` is the terminal the question was seen in: after a Herdr restart the same pane asks at the
  // same state number again, and a tap from before it must not answer the question after it.
  component Answer(a, o, q, strong) {
    Box {
      fill: width
      onTap: {
        if busy == "" {
          busy = q
          said = ""
          sent = run("printf '{\"n\":%s,\"r\":' ${int(random(1000000000))}; printf %s ${sh(toJson(merge({machine: a.machine, session: a.session, pane: a.pane, seq: a.seq, id: a.ask.id, term: a.term ?? ""}, o.key != null ? {key: o.key} : {n: o.n, label: o.label})))} | ssh -o BatchMode=yes -o ConnectTimeout=8 -o ServerAliveInterval=5 -o ServerAliveCountMax=3 sg projects/ormus-feeds/bin/answer -; printf '}'")
        }
      }
      Key { word: busy == q ? "…" : "${o.n} ${o.label}"; strong: strong }
    }
  }

  // One agent that needs him. The label is one line that says what the blockage is (the feed's `summary`: the
  // dialog's heading and the agent's line about the command, a pick list's question, what the agent needs at a
  // free prompt), under it where it is; then up to three numbered keys that move it forward (`choices`: the
  // dialog's answers, or his replies at a free prompt). A tap anywhere else on the card opens the agent in
  // Mercurio. On the tile (`compact`: little room) that is all; the screen also shows the question, what a yes
  // would run and why, the whole command when it fits (`lines` is the room for it, `wide` the characters one line
  // holds), and the longer lists of answers. A command the screen did not show whole, or too long to carry, has no
  // keys anywhere, whatever the feed says: he opens the agent.
  component NeedCard(a, lines, wide) {
    Column {
      gap: 6
      padding: [12, 10]
      radius: 10 * corners
      background: alpha(foreground, 0.07)
      onTap: {
        if mercurio != null && get(links, a.machine, null) != null {
          androidIntent({package: mercurio.package, component: "org.connectbot.ui.MainActivity", action: "android.intent.action.VIEW", data: get(links, a.machine, ""), extras: {"solutions.ormus.logos.extra.HERD_PANE": a.pane, "solutions.ormus.logos.extra.HERD_SESSION": a.session, "solutions.ormus.logos.extra.HERD_VIEW": "chat", "solutions.ormus.logos.extra.HERD_HOSTS": join(get(hosts, a.machine, []), ",")}})
        } else {
          androidApp(mercurio != null ? mercurio.package : "solutions.ormus.logos")
        }
      }
      let ask = a.ask
      let compact = lines < 100
      let q = "${a.machine}:${a.session}:${a.pane}:${a.seq}:${ask != null ? ask.id : ""}"
      let shown = ask != null ? (ask.run ?? ask.what ?? "") : ""
      let need = shown == "" ? 0 : sum(split(shown, "\n").map(r => max(1, ceil(len(r) / max(8, wide)))))
      // A yes also needs the whole command from the feed (`run`): a feed from before it carried one has only the
      // command's first line (`what`), and that is shown with no answers.
      // A command the screen did not show whole, or too long to carry, gets no keys here either, whatever the feed says.
      let whole = ask != null && !ask.cut && !(ask.more ?? false) && (!ask.approval || (ask.run ?? "") != "")
      // On the screen the keys show only under the whole command; the tile shows no command, so there they show
      // when the feed has the whole of it.
      let fits = whole && (compact || need <= lines)
      let answers = ask != null && !(ask.sent ?? false) ? (ask.choices ?? []) : []
      // Keys side by side when each numbered label fits its share of the card's width (about 9 dp a character at this size).
      let per = max(6, floor(wide * 7.5 / max(1, len(answers)) / 9) - 3)
      let short = len(answers) <= 3 && all(answers, o => len(o.label) + 2 <= per)
      // What the blockage is, in one line; with no ask, what the agent needs or its title.
      let label = ask != null ? (ask.summary ?? (ask.question != "" ? ask.question : "needs you")) : (a.needs ?? (a.title != "" && a.title != "Claude Code" ? a.title : a.tab != "" && !endsWith(a.tab, "Shell") ? a.tab : "needs you"))
      Row {
        gap: 8
        align: center
        Text { text: "${lower(a.project)} · ${a.board}"; fontSize: 12; color: muted; weight: 1; maxLines: 1 }
        Text { text: len(cards) > 1 ? "${at + 1} of ${len(cards)}" : ""; fontSize: 12; color: muted; maxLines: 1 }
      }
      Text { text: label; fontSize: 17; bold: true; maxLines: 2 }
      Text { text: "${ask != null && ask.tool != "" ? ask.tool : a.kind} on ${a.machine}${ask != null && (ask.prompt ?? false) ? " · at its prompt" : ""}"; fontSize: 12; color: muted; maxLines: 1 }
      if ask != null && !compact {
        if ask.question != "" && ask.question != label {
          Text { text: ask.question; fontSize: 14; maxLines: 2 }
        }
        if ask.about != "" && ask.about != label {
          Text { text: ask.about; fontSize: 13; maxLines: 2 }
        }
        if shown != "" {
          Text { text: shown; font: mono; fontSize: 12; maxLines: fits ? 4000 : lines }
        }
        if ask.cut || (ask.more ?? false) {
          Text { text: ask.cut ? "the screen does not show all of it (${ask.lines} lines)" : "${ask.lines} lines: this is not all of it"; fontSize: 12; color: red; maxLines: 1 }
        } else if whole && !fits {
          Text { text: "${ask.lines} lines: read it all before a yes"; fontSize: 12; color: muted; maxLines: 1 }
        }
        if ask.why != "" {
          Text { text: ask.why; fontSize: 13; color: muted; maxLines: 2 }
        }
      } else if ask != null && (ask.cut || (ask.more ?? false)) {
        Text { text: "the command is not whole here: open the agent"; fontSize: 12; color: red; maxLines: 1 }
      }
      if ask != null && (ask.sent ?? false) {
        Row {
          gap: 8
          align: center
          Text { text: "answered from here"; fontSize: 13; color: green; weight: 1; maxLines: 1 }
          OpenAgent { a: a; word: "open" }
        }
      } else if len(answers) > 0 && fits && !pinned {
        // The card came in under the thumb, not by his hand: one tap pins it, and its keys show.
        Box {
          fill: width
          onTap: pick = ids[at]
          Key { word: "show 1 · 2 · 3"; strong: true }
        }
      } else if len(answers) > 0 && fits && short {
        Row {
          gap: 8
          for o, i in answers key "${o.n}" {
            Answer { a: a; o: o; q: q; strong: i == 0; weight: 1 }
          }
        }
      } else if len(answers) > 0 && fits {
        Column {
          gap: 6
          for o, i in answers key "${o.n}" {
            Answer { a: a; o: o; q: q; strong: i == 0; fill: width }
          }
        }
      } else if len(answers) > 0 && whole {
        Box {
          fill: width
          onTap: screen()
          Key { word: "read it all"; strong: true }
        }
      } else {
        OpenAgent { a: a; word: "open in Mercurio"; fill: width }
      }
      if said != "" && busy == "" && saidFor == q {
        Text { text: said; fontSize: 13; color: startsWith(said, "unlocked") ? green : red; maxLines: 2 }
      }
    }
  }

  // The cards, one at a time: swipe sideways for the next or the one before, or tap the arrows. The card follows
  // the finger a little and springs back; a pull past 70 dp, or a flick, turns it.
  component Cards(lines, wide) {
    Column {
      gap: 4
      Box {
        drag: horizontal
        onDrag: dragX = dragX + dx
        onDragEnd: {
          let n = len(cards)
          if n > 1 && (dragX < -70 || vx < -600) && at < n - 1 {
            pick = ids[at + 1]
            haptic()
          } else if n > 1 && (dragX > 70 || vx > 600) && at > 0 {
            pick = ids[at - 1]
            haptic()
          }
          dragX = 0
        }
        offset: [dragX * 0.6, 0]
        opacity: 1 - min(0.5, abs(dragX) / 400)
        animate offset: spring()
        animate opacity: tween(150ms, "out")
        NeedCard { a: card; lines: lines; wide: wide }
      }
      if len(cards) > 1 {
        // Up to seven dots (the card's header counts them all), the one shown bigger and brighter.
        Row {
          gap: 6
          align: center
          justify: center
          Text { text: "‹"; fontSize: 20; color: at > 0 ? foreground : alpha(foreground, 0.3); padding: [18, 10]; onTap: { dragX = 0; if at > 0 { pick = ids[at - 1] } } }
          for id, i in ids.take(7) key "${id}:${i}" {
            Box { size: i == at ? 8 : 6; radius: 4; background: i == at ? foreground : alpha(foreground, 0.3) }
          }
          Text { text: "›"; fontSize: 20; color: at < len(cards) - 1 ? foreground : alpha(foreground, 0.3); padding: [18, 10]; onTap: { dragX = 0; if at < len(cards) - 1 { pick = ids[at + 1] } } }
        }
      }
    }
  }

  // The headline: who needs him is the one thing in gold, with the score of the day beside it (the level and the
  // streak on the screen), and the other counts under it.
  component Headline(full) {
    Column {
      gap: 2
      Row {
        gap: 8
        align: center
        Text { text: needs > 0 ? "${needs} need you" : "nobody needs you"; fontSize: 24; bold: true; color: needs > 0 ? accent : green; weight: 1; maxLines: 1 }
        if game != null {
          Progress { value: game.into; max: game.need; width: 48; height: 4; color: foreground; track: alpha(foreground, 0.2) }
          Text { text: "${game.today} today"; fontSize: 12; color: muted; maxLines: 1 }
        }
      }
      if said != "" && busy == "" && saidFor != shownQ {
        Text { text: said; fontSize: 12; color: startsWith(said, "unlocked") ? green : red; maxLines: 1 }
      } else {
        Text { text: "${working} working · ${done} done · ${waiting} chats wait${full && game != null ? " · level ${game.level}${game.streak > 1 ? " · ${game.streak} days" : ""}" : ""}"; fontSize: 12; color: muted; maxLines: 1 }
      }
    }
  }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: only == "" ? "sessions" : only; style: muted; weight: 1 }
      Text { text: f == null ? "…" : data == null ? "sg doesn't answer" : stale ? "as of ${floor((now - data.generated) / 60)}m ago" : len(down) > 0 ? "${join(down, ", ")} didn't answer" : len(failed) > 0 ? "${join(failed, ", ")} unreadable" : ""; fontSize: 12; color: data == null || len(down) > 0 || len(failed) > 0 ? red : muted; weight: 2; align: end; maxLines: 1 }
    }
    if data != null && only != "" && len(boards) == 0 {
      Text { text: "no ${only} board in the feed"; style: body; color: red }
    } else if data != null {
      Headline { full: false }
      if card != null {
        Cards { lines: cardLines; wide: wide }
      }
      if only == "" && card == null {
        Row {
          gap: 12
          // Per workboard: agents that need him plus chats that wait, green; the screen has the agents by board.
          for b in live.filter(b => b.agents.blocked + (b.waiting ?? 0) > 0).take(5) key b.name {
            Text { spans: [b.name, " ", {text: "${b.agents.blocked + (b.waiting ?? 0)}", color: green, bold: true}]; fontSize: 12; color: muted; maxLines: 1 }
          }
        }
      }
      for i in rows.take(room) key "${i.row}:${i.board}:${i.project}:${i.machine ?? ""}:${i.session ?? ""}:${i.pane ?? i.k ?? i.name}" {
        Item { i: i; where: "${lower(i.project)}"; withText: false }
      }
      if len(rows) > room {
        Text { text: "+${len(rows) - room} more · ${only == "" ? "tap for every workboard" : "tap for all of ${only}"}"; fontSize: 12; color: muted; maxLines: 1 }
      }
    }
  }

  screen {
    title: only == "" ? "sessions" : only
    Column {
      scroll: true
      gap: 12
      padding: [4, 8]
      if data == null {
        Text { text: f == null ? "…" : "sg doesn't answer"; style: body; color: red }
      } else if only != "" && len(boards) == 0 {
        Text { text: "no ${only} board in the feed"; style: body; color: red }
      } else {
        Headline { full: true }
        if card != null {
          Cards { lines: 4000; wide: floor(((screenWidth ?? 360) - 64) / 7.5) }
        }
        if stale || len(down) > 0 {
          Text { text: stale ? "as of ${floor((now - data.generated) / 60)}m ago" : "${join(down, ", ")} didn't answer: their agents are missing"; fontSize: 13; color: red }
        }
        let moves = (data.moves ?? []).filter(m => only == "" || m.board == only)
        if len(moves) > 0 {
          Column {
            gap: 2
            Text { text: "MOVED LATELY"; style: label }
            for m in reverse(moves).take(8) key "${m.n}" {
              Row {
                gap: 8
                align: center
                padding: [0, 3]
                Text { text: m.kind == "needs" ? "needs you" : m.kind == "done" ? "done" : m.kind == "chat" ? "chat" : "moved"; fontSize: 12; width: 66; maxLines: 1; color: m.kind == "done" || m.kind == "chat" ? green : m.kind == "needs" ? accent : foreground }
                Text { text: "${m.title} · ${m.text}"; fontSize: 13; weight: 1; maxLines: 1 }
                Age { m: now != null ? max(0, floor((now - m.at) / 60)) : null }
              }
            }
          }
        }
        Row {
          gap: 8
          align: center
          Text { text: modes == null ? "" : modes.dndAllows == "priority" ? "quiet is on: your exceptions only" : modes.dnd ? "quiet is on: ${modes.dndAllows == "alarms" ? "alarms only" : "total silence"}" : "quiet is off: every app can alert"; fontSize: 13; color: muted; weight: 1; maxLines: 2 }
          Button { text: modes != null && modes.dnd ? "turn off" : "quiet"; color: foreground; onTap: dnd(modes != null && modes.dnd ? "all" : "priority") }
        }
        for b in live key b.name {
          Column {
            gap: 4
            Row {
              align: center
              Text { text: upper(b.name); style: label; color: foreground; weight: 1 }
              Text { text: "${b.agents.blocked} need you · ${b.agents.working} working · ${b.agents.done} done · ${b.agents.idle} idle"; fontSize: 12; color: muted; align: end; maxLines: 1 }
            }
            for p in b.projects.filter(p => len(p.top) > 0 || len(p.chats ?? []) > 0) key p.name {
              Column {
                gap: 2
                padding: [0, 2]
                Text { text: p.name; fontSize: 13; bold: true; color: muted }
                for a in p.top key "${a.machine}:${a.session}:${a.pane}" {
                  Item { i: merge(a, {row: "agent", project: p.name}); where: "${a.kind} · ${a.machine}"; withText: true }
                }
                for c in p.chats ?? [] key c.k ?? c.name {
                  Item { i: merge(c, {row: "chat"}); where: c.slot != null ? "priority ${c.slot}" : c.group ? "group" : ""; withText: true }
                }
              }
            }
          }
        }
        if len(loose) > 0 {
          Column {
            gap: 2
            Text { text: "WAITS ON YOU, NO PROJECT"; style: label }
            for c in loose key c.k ?? c.name {
              Item { i: c; where: c.group ? "group" : ""; withText: true }
            }
          }
        }
        for n in data.notes ?? [] {
          Text { text: n; fontSize: 13; color: muted }
        }
        for k in failed {
          Text { text: "${k}: ${data.errors[k]}"; fontSize: 13; color: red }
        }
      }
    }
  }
}
