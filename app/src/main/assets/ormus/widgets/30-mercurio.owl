widget "mercurio" {
  page: 2
  order: 1
  size: 6x4
  minSize: 3x2

  meta { owl: 17; description: "Ormus's herdr-core agents on Sun, sg and Mars: who waits on him, who works, who finished, then the latest idle ones, with project, machine and how long ago. Tap one to attach to its terminal."; version: "3.0"; license: "MIT"; category: "productivity" }

  // Every machine's agents from sg's sessions feed (ormus-feeds), which reads herdr-core (`hc`) on Sun, sg and Mars
  // each minute. The old herdr TUI is gone (Ormus, 2026-11-15: "make sure that mercurio and all widgets are connected
  // properly to herdr core"); before, this tile asked each machine's TUI itself over ssh.
  source f = http("https://sg.tailb43a3a.ts.net/feeds/sessions.json") every 60s json timeout 20s status
  source now = clock every 1m

  let data = f != null && f.ok && f.out != null && f.out.boards != null ? f.out : null
  // Each project's agents, with the project's name; one agent counts once even when two boards list it.
  let listed = data == null ? [] : flatten(data.boards.map(b => flatten((b.projects ?? []).map(p => (p.top ?? []).map(a => merge(a, {ws: p.name}))))))
  let ids = listed.map(a => "${a.machine}:${a.pane}")
  let all = listed.filter((a, i) => indexOf(ids, "${a.machine}:${a.pane}") == i)
  // A machine the feed could not read: its agents are missing, not quiet.
  let down = data == null ? [] : keys(data.machines ?? {}).filter(m => data.machines[m] != "ok")
  let stale = data != null && now != null && now - data.generated > 180
  // The counts are the feed's own totals: a project lists 8 agents at most (the feed's TOP_PER_PROJECT), and the feed
  // counts a `done` agent of long ago as idle.
  let totals = data != null && data.agents != null ? data.agents : {}
  let waiting = totals.blocked ?? 0
  let working = totals.working ?? 0
  let done = totals.done ?? 0
  let total = waiting + working + done + (totals.idle ?? 0)
  // A herdr-core agent's `seq` is when its state last changed, in ms since 1970: newest first in each group.
  // Whoever waits on Ormus first, then the ones at work, then the finished ones, newest first in each; idle ones
  // fill what room is left, most recently active first.
  let busy = all.filter(a => a.status != "idle").sortBy(a => (a.status == "blocked" ? 0 : a.status == "working" ? 1 : 2) * 10000000000000 - num(a.seq, 0))
  let idle = all.filter(a => a.status == "idle").sortBy(a => -num(a.seq, 0))
  // As many lines as the tile holds: about 25 dp each, after the padding and the header.
  let room = max(2, floor(((tileHeight ?? 136) - 50) / 25))
  let shown = flatten([busy.take(room), idle.take(max(0, room - len(busy)))])

  // Mercurio ships as solutions.ormus.logos, or .debug from a dev build: open whichever the phone has.
  source apps = android.apps every 10m
  let mercurio = (apps ?? []).find(a => a.package == "solutions.ormus.logos") ?? (apps ?? []).find(a => a.package == "solutions.ormus.logos.debug")
  onTap: androidApp(mercurio != null ? mercurio.package : "solutions.ormus.logos")

  component AgentLine(a) {
    Row {
      gap: 8
      align: center
      let ago = now == null || num(a.seq, 0) <= 0 ? "" : floor((now * 1000 - num(a.seq, 0)) / 60000)
      Text { text: a.status == "blocked" ? "waiting" : a.status; style: small; width: 58; color: a.status == "blocked" ? red : a.status == "working" ? blue : muted }
      Text { text: a.title != "" && a.title != "Claude Code" ? a.title : a.tab != "" ? a.tab : a.kind; style: body; maxLines: 1; weight: 1; color: a.status == "idle" ? muted : foreground }
      Text { text: "${lower(a.ws)}·${a.machine}"; style: small; color: muted; width: 84; align: end; maxLines: 1 }
      Text { text: ago == "" ? "" : ago < 60 ? "${max(0, ago)}m" : ago < 1440 ? "${floor(ago / 60)}h" : "${floor(ago / 1440)}d"; style: small; color: muted; width: 28; align: end; maxLines: 1 }
    }
  }

  Column {
    gap: 6
    Row {
      align: center
      // A Text fills its row unless it has a width or weight, so each gets a share.
      Text { text: "mercurio · ${total}"; style: muted; weight: 1; maxLines: 1 }
      Text { text: f == null ? "…" : data == null ? "sg doesn't answer" : "${waiting} waiting · ${working} working · ${done} done"; style: small; color: waiting > 0 || data == null ? red : muted; weight: 2; align: end; maxLines: 1 }
    }
    if len(down) > 0 {
      Text { text: "${join(down, ", ")} didn't answer: their agents are missing"; style: small; color: red; maxLines: 1 }
    }
    if stale {
      Text { text: "as of ${floor((now - data.generated) / 60)}m ago"; style: small; color: red; maxLines: 1 }
    }
    for a in shown key "${a.machine}:${a.pane}" {
      // A tap attaches the launcher's terminal to the agent's herdr-core terminal, over the guest's ssh to its
      // machine (Mercurio opens no herdr-core terminal from a launcher's tap yet).
      Box {
        onTap: terminal("ssh -t ${sh(a.machine)} ${sh("PATH=$HOME/.local/bin:$PATH exec hc attach " + a.pane)}", a.title != "" ? a.title : "agent")
        AgentLine { a: a }
      }
    }
  }
}
