widget "ai usage" {
  page: 601
  order: 8
  size: 6x4
  minSize: 4x3

  meta { owl: 13; description: "How much of each AI plan is used, on every account (Claude, ChatGPT, Grok), and when each limit resets. Each account shows its email in place of its name when the phone's own file gives it and the row still has room for its number (the feed holds none). The account with the fullest window has its name in gold, a full window red, from 80% yellow. When sg does not answer, its last numbers stay: the header gives their age after 30 min, the screen always. Tap an account for the service's usage page, the tile for every window."; version: "1.1"; license: "MIT"; category: "system" }

  // Built on sg (ormus-feeds) every 10 min: a probe reads each account on a machine signed in to it, with that
  // machine's own token, and only usage numbers come back. The feed names the accounts and holds no email.
  source f = http("https://sg.tailb43a3a.ts.net/feeds/usage.json") every 5m json timeout 20s status
  source now = clock every 1m
  // The phone's own map of account keys to emails, written from sg by hand (`usage.py emails`), as the feed holds no
  // email. A missing file reads as "": every account keeps its name.
  source mails = file("~/.config/omalauncher/usage-emails.json") json optional

  // Only the feed counts as the feed: a page in its place (json keeps it as text) is said, never "0 accounts".
  let fresh = f != null && f.ok && f.out != null && (f.out.accounts != null || f.out.off != null) ? f.out : null
  // The last feed with accounts, kept across restarts: while sg doesn't answer, its numbers stay.
  state kept = null persist
  on fresh first { if value.accounts != null { kept = value } }
  let data = fresh ?? kept
  let failed = f != null && !f.ok
  let garbled = f != null && f.ok && fresh == null
  let off = data != null && data.off != null
  let accounts = data != null && !off ? (data.accounts ?? []) : []
  let missed = data != null && !off ? keys(data.machines ?? {}) : []
  let problems = data != null && !off ? (data.errors ?? []) : []
  // Older than 30 min, sg's runner has stopped: the numbers say how old they are.
  let late = data != null && !off && now != null && now - data.generated > 1800
  // "just now" under a minute (or ahead of the phone's clock), "" while the time or the clock is unknown.
  let fedAgo = data == null || data.generated == null || now == null ? "" : now - data.generated < 60 ? "just now" : "${fmtAgo(data.generated, now)} ago"
  // The fullest window is the one gold element, until it resets.
  let topKey = data != null && !off && data.top != null && (data.top.resets == null || now == null || data.top.resets > now) ? data.top.key : ""
  // About 32 dp an account under the header.
  let room = max(1, floor(((tileHeight ?? 272) - 40) / 32))
  let hidden = max(0, len(accounts) - room)
  // Characters a row holds: the small style is 6.47 dp a character at 2.63 px a dp (measured on the phone); 12 dp
  // padding a side.
  let rowChars = floor(((tileWidth ?? 360) - 24) / 6.5)

  // One account: its fullest window that has not reset by the phone's clock, and a bar for it. A tap opens the
  // service's usage page.
  component Account(a, gold) {
    Box {
      onTap: url(a.open)
      Column {
        gap: 3
        let live = a.windows.filter(x => x.percent != null && (x.resets == null || now == null || x.resets > now))
        let w = live.sortBy(x => -x.percent).first()
        // Reset by the feed or by the phone's clock; a window with no number and no reset time is unknown, not reset.
        let reset = a.windows.filter(x => x.reset == true || (x.resets != null && now != null && x.resets <= now)).first()
        let read = a.read == null || now == null ? "" : now - a.read < 60 ? "just now" : "${fmtAgo(a.read, now)} ago"
        let stale = a.state == "stale" && read != ""
        let left = a.note ?? a.plan ?? ""
        let full = w != null && (w.percent >= 100 || (a.limited && w.percent == a.peak))
        // Each row has a long text and a short one ("week Fable 73%" and "73%"); a stale row adds its age. A row with
        // nothing else in it gives the age alone, with no separator in front.
        let words = a.state == "unread" ? a.error ?? "" : w != null ? "${w.label} ${w.percent}%" : len(a.windows) > 0 ? (reset != null ? "${reset.label} reset" : "use unknown") : left
        let short = a.state == "unread" ? a.error ?? "" : w != null ? "${w.percent}%" : len(a.windows) > 0 ? (reset != null ? "reset" : "unknown") : left
        // OWL trims the end of an interpolated value: the " · " stays in the literal text.
        let old = !stale ? "" : words == "" ? "as of ${read}" : " · as of ${read}"
        let aged = words == "" ? read : "${words} · ${read}"
        let shortAged = words == "" ? read : "${short} · ${read}"
        // The account's email when its short text still fits beside it (a stale row's with its age), else its name:
        // the email never costs the number.
        // Only text is an email (toJson writes text, and only text, in quotes), without the spaces around it: a
        // number, a yes/no, a list, a map or a blank leaves the name.
        let raw = get(mails, a.key, "")
        let mail = startsWith(toJson(raw), "\"") ? trim(raw) : ""
        let label = mail != "" && rowChars - len("${a.service_name} ${mail}") - 2 >= len(stale ? shortAged : short) ? "${a.service_name} ${mail}" : "${a.service_name} ${a.name}"
        // Characters left for the text after the label and the 8 dp gap (2 characters).
        let space = rowChars - len(label) - 2
        // A row too long for the tile drops one part at a time: the word "resets", the reset time, "as of ", the
        // label (a row that is not stale keeps only its short text), then the last words of its short text, with "…",
        // so the age stays whole and a number is shown whole or not at all. The feed's own words with no age (a note,
        // an error) are cut by the renderer; the screen shows them.
        let due = a.state != "unread" && w != null && w.resets != null && now != null ? fmtAgo(w.resets, now) : ""
        let tail = due == "" ? "" : len(words) + len(old) + 10 + len(due) <= space ? " · resets ${due}" : len(words) + len(old) + 3 + len(due) <= space ? " · ${due}" : ""
        // The first whole words of the short text that fit before "… · " and the age ("180 credits" of "180 credits left").
        // The builtin words(...), not the let words above, splits at any space, tab or newline and keeps no empty word.
        let parts = words(short)
        let cut = join(take(parts, count(scan(parts, (s, x) => s + len(x) + 1, -1), s => s <= space - len(read) - 4)), " ")
        Row {
          gap: 8
          align: center
          Text { text: label; style: small; bold: true; maxLines: 1; color: gold ? accent : a.state == "ok" ? foreground : muted }
          Text {
            text: len(words) + len(old) <= space ? "${words}${tail}${old}" : !stale ? short : len(aged) <= space ? aged : len(shortAged) <= space ? shortAged : cut == "" ? read : "${cut}… · ${read}"
            style: small
            maxLines: 1
            weight: 1
            align: end
            color: a.state != "ok" ? yellow : w != null ? foreground : muted
          }
        }
        if w != null {
          Progress { value: w.percent; color: full ? red : w.percent >= 80 ? yellow : alpha(foreground, 0.55); track: alpha(foreground, 0.12) }
        }
      }
    }
  }

  onTap: screen()

  Column {
    gap: 6
    Row {
      align: center
      Text { text: "ai usage"; style: muted }
      // Kept numbers older than 30 min say their age next to the failure (the screen always does); hidden rows are
      // counted in front of any message.
      let age = late ? " · as of ${fedAgo}" : ""
      let note = f == null ? "…" : failed ? "sg doesn't answer${age}" : garbled ? "not the usage feed${age}" : off ? "off on sg" : late ? "as of ${fedAgo}" : len(problems) > 0 ? join(problems, " · ") : len(missed) > 0 ? "${join(missed, ", ")} not reached" : ""
      Text {
        text: hidden > 0 ? (note == "" ? "+${hidden} more" : "+${hidden} · ${note}") : note != "" ? note : len(accounts) == 1 ? "1 account" : "${len(accounts)} accounts"
        style: small
        maxLines: 1
        weight: 1
        align: end
        color: failed || garbled || off ? red : late || len(problems) > 0 ? yellow : muted
      }
    }
    if data != null && !off && len(accounts) == 0 && len(problems) == 0 {
      Text { text: "no account listed on sg"; style: body; color: muted }
    }
    for a in accounts.take(room) key a.key {
      Account { a: a; gold: a.key == topKey }
    }
  }

  screen {
    title: "ai usage"
    Column {
      scroll: true
      gap: 18
      if data == null || off || failed || garbled {
        Text { text: "${f == null ? "loading…" : failed ? "sg doesn't answer" : garbled ? "sg's answer is not the usage feed" : "the usage feed is off on sg"}${data != null && !off ? "; these are its last numbers" : ""}"; style: body; color: data != null && !off ? yellow : muted }
      }
      for a in accounts key a.key {
        Column {
          gap: 6
          let read = a.read == null || now == null ? "" : now - a.read < 60 ? "just now" : "${fmtAgo(a.read, now)} ago"
          let raw = get(mails, a.key, "")
          let mail = startsWith(toJson(raw), "\"") ? trim(raw) : ""
          Box {
            onTap: url(a.open)
            Row {
              gap: 8
              align: bottom
              Text { text: "${a.service_name} ${a.name}"; style: title; maxLines: 1; weight: 1; color: a.key == topKey ? accent : foreground }
              Text { text: a.plan ?? ""; style: small; color: muted; maxLines: 1 }
            }
          }
          if mail != "" {
            Text { text: mail; style: small; color: muted; maxLines: 1 }
          }
          if a.state != "ok" {
            Text { text: a.state == "stale" ? (read == "" ? "now: ${a.error}" : "as of ${read} · now: ${a.error}") : a.error; style: small; color: yellow }
          }
          // The reset column holds "resets Wed 30 23:59": 19 characters of 6.47 dp (measured on the phone).
          for w in a.windows {
            Column {
              gap: 3
              let past = w.resets != null && now != null && w.resets <= now
              let shown = w.percent != null && !past
              Row {
                gap: 8
                align: center
                Text { text: w.label; style: body; maxLines: 1; weight: 1 }
                Text { text: shown ? "${w.percent}%" : past || w.reset == true ? "reset" : "unknown"; style: body; bold: shown; color: shown ? foreground : muted }
                Text { text: w.resets == null ? "" : "${past || w.reset == true ? "reset" : "resets"} ${fmtTime(w.resets, "EEE d HH:mm", null, "en")}"; style: small; color: muted; width: 128; align: end; maxLines: 1 }
              }
              if shown {
                Progress { value: w.percent; color: w.percent >= 100 || (a.limited && w.percent == a.peak) ? red : w.percent >= 80 ? yellow : alpha(foreground, 0.55); track: alpha(foreground, 0.12) }
              }
            }
          }
          if a.note != null {
            Text { text: a.note; style: small; color: muted }
          }
        }
      }
      if data != null && !off {
        Column {
          gap: 4
          Text { text: "read on sg ${fedAgo == "" ? "…" : fedAgo}, every 10 min"; style: small; color: late ? yellow : muted }
          for m in missed {
            Text { text: "${m}: ${get(data.machines, m, "")}"; style: small; color: muted }
          }
          for p in problems {
            Text { text: p; style: small; color: yellow }
          }
          Text { text: "Tap an account for the service's own usage page."; style: small; color: muted }
        }
      }
    }
  }
}
